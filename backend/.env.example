# Environment configuration for CRM Backend
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Frontend origin for CORS (e.g., https://your-crm-app.vercel.app)
# Leave blank to allow all origins during development
CLIENT_URL=https://your-crm-frontend.vercel.app

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/crm_sales_system?retryWrites=true&w=majority

# Optional persistent storage paths on Render (when using a Render Persistent Disk)
# DB_PATH=/var/data/crm.sqlite
# STORAGE_DIR=/var/data

